{
	"name": "n8n-nodes-zalo-platform",
	"version": "2.0.0",
	"description": "n8n community node for Zalo Bot Platform - send messages, photos, stickers and manage webhooks",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"zalo",
		"zalo-bot",
		"messaging",
		"vietnam",
		"chatbot"
	],
	"license": "MIT",
	"homepage": "https://hecigo.com/blog/n8n-zalo-bot-node-what-breaks-in-production/",
	"author": {
		"name": "hecigo",
		"email": "hi@hecigo.com",
		"url": "https://hecigo.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/hecigo/n8n-nodes-zalo-platform.git"
	},
	"main": "index.js",
	"scripts": {
		"prebuild": "rimraf dist",
		"build": "tsc && gulp build:assets",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint package.json nodes credentials",
		"lintfix": "eslint package.json nodes credentials --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/ZaloBotApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/ZaloBot/ZaloBot.node.js",
			"dist/nodes/ZaloBot/ZaloBotTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/eslint-plugin-community-nodes": "^0.29.0",
		"@types/node": "^25.5.0",
		"@typescript-eslint/parser": "^8.0.0",
		"eslint": "^9.0.0",
		"eslint-plugin-n8n-nodes-base": "^2.0.0",
		"gulp": "^4.0.2",
		"n8n-workflow": "^2.0.0",
		"prettier": "^3.2.0",
		"rimraf": "^5.0.0",
		"typescript": "^5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
